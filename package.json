{
  "name": "gcc-orderbot",
  "version": "1.0.0",
  "description": "Hyper-local WhatsApp & Instagram Conversational Sales Agent for GCC merchants (Bahrain, KSA, UAE)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/index.ts",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "tsc && npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "whatsapp",
    "gcc",
    "bahrain",
    "benefitpay",
    "tap-payments",
    "conversational-ai",
    "gemini"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3"
  }
}
